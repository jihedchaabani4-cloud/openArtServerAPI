{
  "modelId": "nanobana_pro_ultra",
  "providerId": "wavespeed",
  "priority": 1,
  "status": "active",
  "parameterMap": {
    "prompt": {
      "providerField": "prompt"
    },
    "aspect_ratio": {
      "providerField": "aspect_ratio"
    },
    "resolution": {
      "providerField": "resolution"
    },
    "quality": {
      "providerField": "quality"
    },
    "reference_images": {
      "providerField": "reference_images"
    },
    "seed": {
      "providerField": "seed"
    }
  },
  "staticPayload": {
    "output_format": "png"
  },
  "pricing": {
    "base_cost_usd": 0.20,
    "modifiers": {
      "resolution": {
        "1k": 1,
        "2k": 1.5,
        "4k": 2.2,
        "8k": 3.5
      }
    }
  },
  "routes": [
    {
      "id": "generation",
      "when": {
        "input_image": "absent"
      },
      "providerModelId": "google/nano-banana-pro/text-to-image-ultra",
      "endpoint": "google/nano-banana-pro/text-to-image-ultra"
    },
    {
      "id": "edit",
      "when": {
        "input_image": "present"
      },
      "providerModelId": "google/nano-banana-pro/edit-ultra",
      "endpoint": "google/nano-banana-pro/edit-ultra",
      "parameterMap": {
        "input_image": {
          "providerField": "images",
          "transform": "wrap_array"
        }
      },
      "pricing": {
        "base_cost_usd": 0.25,
        "modifiers": {
          "resolution": {
            "1k": 1,
            "2k": 1.5,
            "4k": 2.2,
            "8k": 3.5
          }
        }
      },
      "retailPricing": {
        "table": {
          "1k": 25,
          "2k": 35,
          "4k": 50,
          "8k": 80
        }
      }
    }
  ],
  "outputMap": {
    "images": "outputs"
  },
  "pollingConfig": {
    "pollInterval": 2,
    "timeout": 3600
  },
  "version": "1.0.0"
}
