    "description": "Express.js API for Open Art AI Influencer Studio",
    "main": "index.js",
    "type": "module",
    "imports": {
        "#core/*.js": "./src/core/*.js",
        "#utils/*.js": "./src/utils/*.js",
        "#db/*.js": "./src/db/*.js",
        "#services/*.js": "./src/services/*.js",
        "#video/*.js": "./src/video/*.js",
        "#video/*": "./src/video/*",
