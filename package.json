{
    "name": "labveil-api",
    "version": "1.0.0",
    "description": "Express.js API for Labveil AI Influencer Studio",
    "main": "index.js",
    "type": "module",
    "imports": {
        "#lib/*.js": "./lib/*.js",
        "#core/*.js": "./src/core/*.js",
        "#core/*": "./src/core/*",
        "#utils/*.js": "./src/utils/*.js",
        "#db/*.js": "./src/db/*.js",
        "#services/*.js": "./src/services/*.js",
        "#platform/storage/*.js": "./src/platform/storage/*.js",
        "#platform/workflow/*.js": "./src/platform/workflow/*.js",
        "#platform/media/*.js": "./src/platform/media/*.js",
        "#platform/ai/*.js": "./src/platform/ai/*.js",
        "#platform/billing/*.js": "./src/platform/billing/*.js",
        "#platform/security/*.js": "./src/platform/security/*.js",
        "#domain/character/*.js": "./src/domain/character/*.js",
        "#domain/element/*.js": "./src/domain/element/*.js",
        "#domain/generation/*.js": "./src/domain/generation/*.js",
        "#domain/project/*.js": "./src/domain/project/*.js",
        "#queue/*.js": "./src/queue/*.js",
        "#video/*.js": "./src/video/*.js",
        "#video/*": "./src/video/*",
        "#image/*.js": "./src/image/*.js",
        "#container.js": "./src/container.js"
    },
    "scripts": {
        "start": "node index.js",
        "start:worker": "node src/workers/worker.js",
        "start:v2-worker": "node src/v2/queue/v2WorkflowWorker.js",
        "architecture:validate": "node scripts/architecture/validateArchitecture.mjs && node scripts/architecture/checkRegistryWorkflowResolution.mjs && node scripts/architecture/checkProviderResolver.mjs && node scripts/architecture/checkWorkflowLifecycle.mjs && node scripts/architecture/checkWorkflowFailures.mjs && node scripts/architecture/checkInternalWorkflowCall.mjs && node scripts/architecture/checkWorkflowCallParity.mjs && node scripts/architecture/checkStrictParity.mjs",
        "v2:validate": "node scripts/v2/validateV2.mjs",
        "dev:api": "nodemon index.js",
        "dev:worker": "nodemon --delay 1500 src/workers/worker.js",
        "dev:v2-worker": "nodemon --delay 1500 src/v2/queue/v2WorkflowWorker.js",
        "start:wallet-worker": "node src/workers/walletWorker.js",
        "dev:wallet-worker": "nodemon --delay 1500 src/workers/walletWorker.js",
        "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\""
    },
    "dependencies": {
        "@fal-ai/client": "^1.9.4",
        "@google/generative-ai": "^0.24.1",
        "@huggingface/inference": "^4.13.13",
        "@supabase/supabase-js": "^2.97.0",
        "@upstash/redis": "^1.37.0",
        "bullmq": "^5.75.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.18.3",
        "express-async-handler": "^1.2.0",
        "express-rate-limit": "^8.3.0",
        "ioredis": "^5.10.1",
        "morgan": "^1.10.0",
        "multer": "^2.1.1",
        "node-fetch": "^3.3.2",
        "openai": "^6.25.0",
        "sharp": "^0.34.5",
        "socket.io": "^4.8.3",
        "uuid": "^9.0.1",
        "yaml": "^2.8.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "concurrently": "^9.2.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "nodemon": "^3.1.0",
        "supabase": "^2.84.5"
    }
}
