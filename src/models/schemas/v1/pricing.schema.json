{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["model", "operation", "pricing_version"],
  "properties": {
    "$schema": { "type": "string" },
    "model": { "type": "string" },
    "operation": { "type": "string" },
    "pricing_version": { "type": "string" },
    "currency": { "type": "string", "default": "credits" },
    "base_price": { "type": "number", "minimum": 0 },
    "base_price_per_unit": {
      "type": "object",
      "required": ["unit_param", "rate_per_unit"],
      "properties": {
        "unit_param": { "type": "string" },
        "rate_per_unit": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["multiplier", "per_unit", "flat_addon"] },
            "factor": { "type": "number" },
            "rate": { "type": "number" },
            "amount": { "type": "number" },
            "description": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
