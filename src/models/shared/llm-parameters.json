{
  "domain": "llm",
  "parameters": {
    "messages": {
      "type": "array",
      "required": false,
      "description": "Array of conversation messages with role and content"
    },
    "images": {
      "type": "array",
      "required": false,
      "description": "Optional array of images (Base64 strings or URLs) for multimodal vision analysis"
    },
    "prompt": {
      "type": "string",
      "required": false,
      "description": "Single text prompt for completion models"
    },
    "system_prompt": {
      "type": "string",
      "required": false,
      "description": "System directive guiding the model's behavior"
    },
    "temperature": {
      "type": "number",
      "required": false,
      "default": 0.7,
      "description": "Sampling temperature (0.0 to 2.0)"
    },
    "max_tokens": {
      "type": "number",
      "required": false,
      "default": 2048,
      "description": "Maximum tokens to generate"
    },
    "top_p": {
      "type": "number",
      "required": false,
      "default": 1.0,
      "description": "Nucleus sampling parameter"
    },
    "streaming": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Whether to stream token responses via SSE"
    }
  }
}
