{
  "schemaVersion": "1.0",
  "id": "gpt-image-2.wavespeed",
  "modelFamily": "gpt-image-2",
  "provider": "wavespeed",
  "status": "active",
  "providerModelId": "openai/gpt-image-2/text-to-image",
  "providerModelVersion": "v1.0.0",
  "versionPolicy": "pinned",
  "operations": {
    "text_to_image": {
      "endpoint": "/gpt-image-2/generate",
      "inputs": {
        "prompt": {
          "type": "string",
          "required": true
        },
        "aspect_ratio": {
          "type": "enum",
          "values": [
            "1:1",
            "16:9",
            "9:16",
            "4:3",
            "3:4",
            "3:2",
            "2:3"
          ],
          "default": "1:1"
        },
        "quality": {
          "type": "enum",
          "values": [
            "standard",
            "hd",
            "2k",
            "4k"
          ],
          "default": "standard"
        }
      },
      "outputs": {
        "type": "image",
        "fields": {
          "url": {
            "type": "string",
            "required": true
          }
        }
      },
      "pricing": {
        "mode": "quality_table",
        "table": {
          "standard": "12.000000",
          "hd": "15.000000",
          "2k": "18.000000",
          "4k": "22.000000"
        }
      }
    },
    "edit": {
      "endpoint": "/gpt-image-2/edit",
      "inputs": {
        "prompt": {
          "type": "string",
          "required": true
        },
        "image_url": {
          "type": "image_url",
          "required": true
        },
        "quality": {
          "type": "enum",
          "values": [
            "standard",
            "hd",
            "2k",
            "4k"
          ],
          "default": "standard"
        }
      },
      "outputs": {
        "type": "image",
        "fields": {
          "url": {
            "type": "string",
            "required": true
          }
        }
      },
      "pricing": {
        "mode": "quality_table",
        "table": {
          "standard": "12.000000",
          "hd": "15.000000",
          "2k": "18.000000",
          "4k": "22.000000"
        }
      }
    }
  }
}