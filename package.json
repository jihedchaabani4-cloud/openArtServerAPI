{
    "name": "labveil-api",
    "version": "1.0.0",
    "description": "Express.js API for Labveil AI Influencer Studio",
    "main": "index.js",
    "type": "module",
    "imports": {
        "#lib/*.js": "./lib/*.js",
        "#utils/*.js": "./src/utils/*.js",
        "#db/*.js": "./src/db/*.js",
        "#platform/storage": "./src/platform/storage/index.js",
        "#platform/workflow/*.js": "./src/platform/workflow/*.js",
        "#platform/media/*.js": "./src/platform/media/*.js",
        "#platform/media-ingestion/*.js": "./src/platform/media-ingestion/*.js",
        "#platform/ai/*.js": "./src/platform/ai/*.js",
        "#platform/billing": "./src/platform/billing/index.js",
        "#platform/identity": "./src/platform/identity/index.js",
        "#platform/models": "./src/platform/models/index.js",
        "#domain/character/*.js": "./src/domain/character/*.js",
        "#domain/element/*.js": "./src/domain/element/*.js",
        "#domain/generation/*.js": "./src/domain/generation/*.js",
        "#domain/project/*.js": "./src/domain/project/*.js",
        "#queue/*.js": "./src/queue/*.js",
        "#infrastructure/*.js": "./src/infrastructure/*.js",
        "#container.js": "./src/container.js",
        "#shared": "./src/shared/index.js",
        "#shared/*": "./src/shared/*",
        "#identity/api": "./src/systems/identity/public/api.js",
        "#identity/tools": "./src/systems/identity/public/tools.js",
        "#media/api": "./src/systems/media/public/api.js",
        "#media/tools": "./src/systems/media/public/tools.js",
        "#billing/api": "./src/systems/billing/public/api.js",
        "#billing/tools": "./src/systems/billing/public/tools.js"
    },
    "scripts": {
        "test": "node --import ./tests/setup-env.js --test \"tests/**/*.test.js\"",
        "check:integrity": "node scripts/check-media-integrity.js",
        "models:validate": "node scripts/validate-all-configs.js",
        "start": "node index.js",
        "start:worker": "node src/workers/worker.js",
        "start:v2-worker": "node src/v2/queue/v2WorkflowWorker.js",
        "dev:api": "nodemon index.js",
        "dev:worker": "nodemon --delay 1500 src/workers/worker.js",
        "dev:v2-worker": "nodemon --delay 1500 src/v2/queue/v2WorkflowWorker.js",
        "start:wallet-worker": "node src/workers/walletWorker.js",
        "dev:wallet-worker": "nodemon --delay 1500 src/workers/walletWorker.js",
        "dev": "npm run dev:api",
        "dev:full": "concurrently \"npm run dev:api\" \"npm run dev:worker\"",
        "gate": "node scripts/gate.cjs",
        "catalog": "node scripts/gen-service-catalog.cjs",
        "arch": "node scripts/arch-check.cjs"
    },
    "dependencies": {
        "@fal-ai/client": "^1.9.4",
        "@google/genai": "^2.19.0",
        "@huggingface/inference": "^4.13.13",
        "@supabase/supabase-js": "^2.97.0",
        "@upstash/redis": "^1.37.0",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "bullmq": "^5.75.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "decimal.js": "^10.6.0",
        "dotenv": "^16.4.5",
        "express": "^4.18.3",
        "express-async-handler": "^1.2.0",
        "express-rate-limit": "^8.3.0",
        "ioredis": "^5.10.1",
        "multer": "^2.1.1",
        "node-fetch": "^3.3.2",
        "openai": "^6.25.0",
        "pino": "^10.3.1",
        "rate-limiter-flexible": "^11.2.1",
        "sharp": "^0.34.5",
        "socket.io": "^4.8.3",
        "uuid": "^9.0.1",
        "wavespeed": "^0.3.2",
        "yaml": "^2.8.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "concurrently": "^9.2.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "nodemon": "^3.1.0",
        "pino-pretty": "^13.1.3",
        "supabase": "^2.84.5"
    }
}
