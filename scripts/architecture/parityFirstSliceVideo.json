{
  "featureId": "video-generation",
  "workflowId": "first-slice-video-generation",
  "checks": {
    "successPath": {
      "inputs": {
        "prompt": "a cat playing with a ball of yarn",
        "ratio": "16:9",
        "duration": "5s",
        "model_name": "fal-ai/luma-dream-machine"
      },
      "expectedOutputs": {
        "status": "completed",
        "model": "fal-ai/luma-dream-machine"
      }
    },
    "failurePath": {
      "inputs": {
        "model_name": "unknown-model",
        "prompt": "test"
      },
      "expectedError": {
        "message": "Model not found"
      }
    },
    "billing": {
      "checkpoints": ["reserve", "settle", "rollback"]
    },
    "storage": {
      "checkpoints": ["persistMediaResult"]
    },
    "status": {
      "states": ["queued", "preparing", "executing", "post_processing", "completed", "failed"]
    },
    "events": {
      "expectedOperations": [
        "workflow.request.start",
        "workflow.prepare",
        "workflow.step.VideoTreatment",
        "workflow.capability.video-generation",
        "workflow.complete"
      ]
    }
  }
}
