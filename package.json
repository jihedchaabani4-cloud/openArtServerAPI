        "@upstash/redis": "^1.37.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.18.3",
        "express-async-handler": "^1.2.0",
        "express-rate-limit": "^8.3.0",
        "ioredis": "^5.10.1",
        "morgan": "^1.10.0",
        "multer": "^2.1.1",
        "node-fetch": "^3.3.2",
        "openai": "^6.25.0",
        "sharp": "^0.34.5",
        "socket.io": "^4.8.3",
        "uuid": "^9.0.1",
        "zod": "^4.3.6"
